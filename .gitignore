# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.serena/

# Model artifacts (regeneratable by train_surrogate.py)
models/*.joblib

# Report figures (regeneratable)
reports/figs/

# Raw CFD data / spreadsheets
data/
*.xlsx
*.xlsm

# Legacy manual snapshots (replaced by git history from now on)
sjtu_tpmshx_*_backup/

# Binary assets
Pic/
Picture.zip
*.pdf
*.png
*.jpg
*.jpeg
*.ico
*.npz
# …but README display assets must ship (rendered on the GitHub repo page)
!assets/*.png
!assets/*.svg

# Run logs, caches and benchmark result snapshots (regeneratable)
*.log
*.pkl
sjtu_tpmshx/benchmark_a_*.json
# Profiling snapshots (regeneratable via benchmarks/profiling/profile_*.py)
benchmarks/profiling/*.prof
benchmarks/profiling/*_callees.txt
benchmarks/profiling/*_top30.txt
benchmarks/profiling/*_tottime.txt
# Regenerated doc renders (canonical source = the .md; rebuild on demand)
PROJECT_MANUAL.html
624-Retrodict/COMPUTATION-PIPELINE-CN.html

# Shanghai validation probe outputs (suffixed runs = diagnostics; the
# canonical baseline + archived references are tracked explicitly and
# stay tracked — gitignore only silences new untracked probes)
sjtu_tpmshx/validation/shanghai_3d_baseline?*.csv

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Claude Code superpowers / agent skill files (personal workspace, not project content)
docs/superpowers/

# Per-machine UI state (auto-generated at runtime, never shared)
sjtu_tpmshx/.last_session.json
sjtu_tpmshx/.last_session_*.json   # workspace B/C session slots
sjtu_tpmshx/.workspace             # active-workspace marker
sjtu_tpmshx/.session_timeline.jsonl
sjtu_tpmshx/.theme
sjtu_tpmshx/.density
sjtu_tpmshx/.accent
sjtu_tpmshx/.first_run_done
sjtu_tpmshx/.user_presets.json

# Regeneratable optimizer run outputs + generated inputs.
# Root opt_runs/ holds the archived historical runs (tracked files stay
# tracked); new runs land untracked wherever the launch CWD puts them.
opt_runs/
sjtu_tpmshx/opt_runs/
sjtu_tpmshx/nTop_inputs/

# Agent / tooling scratch (per-machine, not project content)
sjtu_tpmshx/.agents/
sjtu_tpmshx/.claude/
sjtu_tpmshx/skills-lock.json
sjtu_tpmshx/runs/_out/
# Claude Code worktree leftovers (isolation:worktree scratch dirs; root .claude/
# itself stays tracked for agents/ + commands/). Per-machine, not project content.
.claude/worktrees/

# Python packaging metadata (editable installs write into the source tree)
*.egg-info/
